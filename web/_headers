# Cloudflare Pages response headers of the app, which `ems build` writes to
# dist/app/_headers and `ems serve` applies as well; the data parts have
# their own (web/_headers-data, -results, -sources). Syntax and limits:
# https://developers.cloudflare.com/pages/configuration/headers/ (at most
# 100 rules, 2,000 characters per line; a header set by two matching rules
# gets both values joined by a comma, so the Cache-Control rules below must
# not overlap).

# The app runs no inline script and fetches from its own origin and from
# the data parts only: the build fills in connect-src with 'self' and their
# origins (the deployments of the elections' bundles and the results,
# docs/deploy.md; none when they are served from the app's origin, as by
# `ems serve`). The policy makes the browser enforce that. data: images are
# the favicons written inline in the HTML.
/*
  Content-Security-Policy: default-src 'self'; connect-src {{connect_src}}; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The app's code lives in /assets/<v>/, the vendored libraries in
# /assets/vendor/<vv>/ and the images in /assets/img/<iv>/, each version a
# hash of its tree (see build.py), so a URL there always names the same
# bytes: browsers keep them for good. The one rule matches all three
# (:version is <v>, "vendor" or "img"), and nothing else, so no other
# Cache-Control joins it. HTML keeps the Pages default (max-age=0,
# must-revalidate), so a new release reaches every visitor on their next
# page load with the new versions.
/assets/:version/*
  Cache-Control: public, max-age=31536000, immutable

# The app fetches the UI strings with ?v=<their version>, so a release
# with other strings changes the URLs. The lifetime is not forever all the
# same: a page loaded before a deployment still asks for the old version
# and gets the new files under it, and a rollback would bring that version
# back; a day bounds such a mismatch.
/i18n/*
  Cache-Control: public, max-age=86400
