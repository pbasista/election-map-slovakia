# Cloudflare Pages response headers, copied to dist/_headers by `ems
# build` and applied by `ems serve` as well. Syntax and limits:
# https://developers.cloudflare.com/pages/configuration/headers/ (at most
# 100 rules, 2,000 characters per line; a header set by two matching rules
# gets both values joined by a comma, so the Cache-Control rules below must
# not overlap).

# The site loads nothing from other origins, the results included (they
# are in /results/, see below), and runs no inline script; the policy makes
# the browser enforce that. data: images are the favicons written inline in
# the HTML.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The app's code lives in /assets/<v>/, the vendored libraries in
# /assets/vendor/<vv>/ and the images in /assets/img/<iv>/, each version a
# hash of its tree (see build.py), so a URL there always names the same
# bytes: browsers keep them for good. The one rule matches all three
# (:version is <v>, "vendor" or "img"), and nothing else, so no other
# Cache-Control joins it. HTML keeps the Pages default (max-age=0,
# must-revalidate), so a new release reaches every visitor on their next
# page load with the new versions.
/assets/:version/*
  Cache-Control: public, max-age=31536000, immutable

# The stylesheet of the cached copies (below) keeps its name.
/assets/cache.css
  Cache-Control: public, max-age=86400

# The app fetches every JSON file with ?v=<data version>, a hash of all of
# them, so a release with other data changes the URLs. The lifetime is not
# forever all the same: a page loaded before a deployment still asks for
# the old version and gets the new files under it, and a rollback would
# bring that version back; a day bounds such a mismatch.
/i18n/*
  Cache-Control: public, max-age=86400

/data/*
  Cache-Control: public, max-age=86400

/geo/*
  Cache-Control: public, max-age=86400

/addr/*
  Cache-Control: public, max-age=86400

# The results of the election of a day (/results/<day>/, docs/results.md).
# status.json changes with every deployment of new results, so it is always
# revalidated; the app asks for every other file with ?v=<the hash of its
# content that status.json lists>, kept for a day like the other JSON. The
# second rule needs a directory below the day (okres/, okrsky/, ...), so it
# never matches status.json and the two do not overlap.
/results/:day/status.json
  Cache-Control: no-cache

/results/:day/:kind/*
  Cache-Control: public, max-age=86400

# Cached copies of the pages research cites. A copy's name is the hash of
# its content, so it never changes. They are sanitized when cached (no
# scripts, frames or remote loads); the sandbox makes sure nothing in them
# runs or reaches the site's storage, and search engines should index the
# originals, not the copies.
/cache/*
  Content-Security-Policy: sandbox allow-popups allow-popups-to-escape-sandbox
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=86400
