# Response headers of the live results, which `ems build` and `ems results
# deploy` write to dist/live/_headers (src/election_map_slovakia/bundle.py),
# for the Cloudflare Pages project of the live results (docs/deploy.md).
# Syntax and limits as in web/_headers: the Cache-Control rules must not
# overlap.

# The app on the site's own domain fetches the live results from here, so
# every origin may read them. Search engines should index the site instead.
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex

# The live results of the night of the election of a day (/<day>/,
# docs/results.md). status.json changes with every deployment of the night,
# so it is always revalidated; the app asks for every other file with
# ?v=<the hash of its content that status.json lists>, kept for a day: a
# rollback would bring an older content back under the same hash. The
# second rule needs a directory below the day (okres/, kraj/, ...), so it
# never matches status.json and the two do not overlap.
/:day/status.json
  Cache-Control: no-cache

/:day/:kind/*
  Cache-Control: public, max-age=86400
